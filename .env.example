# ── OmniMind AI Backend Production Environment Template ──────────────────────

# Application Settings
APP_NAME="OmniMind AI"
APP_VERSION="0.5.0"
DEBUG=false
SECRET_KEY="generate-a-64-character-random-secret-key"
JWT_SECRET_KEY="generate-a-64-character-jwt-secret-key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL / Managed Database)
# Example: postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://omnimind:omnimind_prod_password@localhost:5432/omnimind_db"
DATABASE_ECHO=false

# Redis Configuration (Managed Redis / Upstash / Render Redis)
REDIS_URL="redis://localhost:6379/0"
CELERY_TASK_ALWAYS_EAGER=false

# AWS S3 / Supabase Storage Configuration (Optional — defaults to local disk fallback)
USE_S3_STORAGE=false
S3_BUCKET_NAME="omnimind-storage"
S3_ENDPOINT_URL=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_NAME="omnimind_pdf_knowledge"

# OpenAI API Key (Optional — fallback tools operate offline without API key)
OPENAI_API_KEY=""
